{
  "name": "nodina-marketing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "node tools/preview.mjs",
    "test": "node --test tests/*.test.mjs && python3 tools/check-site.py",
    "check": "npm run build && npm test",
    "preproduction:check": "npm run check && python3 tools/check-preproduction.py",
    "preproduction:dry-run": "npm run preproduction:check && wrangler deploy --config wrangler.preproduction.json --dry-run --outdir .wrangler/preproduction"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
