{
  "phase": "http_request_dynamic_redirect",
  "rules": [{
    "description": "NODINA www vers domaine canonique",
    "expression": "http.host eq \"www.nodina.com\"",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "status_code": 301,
        "target_url": { "expression": "concat(\"https://nodina.com\", http.request.uri.path)" },
        "preserve_query_string": true
      }
    }
  }]
}
