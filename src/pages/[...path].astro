---
import { locales, pageIds, route, type Locale, type PageId } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomePage from '../components/HomePage.astro';
import OfferPage from '../components/OfferPage.astro';
import VettingPage from '../components/VettingPage.astro';
import ManifestoPage from '../components/ManifestoPage.astro';
import ContactPage from '../components/ContactPage.astro';
import LegalPage from '../components/LegalPage.astro';
import BlogPage from '../components/BlogPage.astro';
export function getStaticPaths() {
  return locales.flatMap(locale => pageIds.map(page => ({
    params: { path: route(locale, page).replace(/^\/|\/$/g, '') }, props: { locale, page },
  })));
}
interface Props { locale: Locale; page: PageId }
const { locale, page } = Astro.props;
const pages = { home: HomePage, systems: OfferPage, teams: OfferPage, vetting: VettingPage, manifesto: ManifestoPage, contact: ContactPage, privacy: LegalPage, cookies: LegalPage, legal: LegalPage, blog: BlogPage };
const Page = pages[page];
---
<SiteLayout locale={locale} page={page}><Page locale={locale} page={page}/></SiteLayout>
