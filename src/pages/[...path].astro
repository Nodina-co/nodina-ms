---
import { locales, pageIds, route, type Locale, type PageId } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomePage from '../components/HomePage.astro';
import VettingPage from '../components/VettingPage.astro';
import ProfilesPage from '../components/ProfilesPage.astro';
import ManifestoPage from '../components/ManifestoPage.astro';
import ContactPage from '../components/ContactPage.astro';
export function getStaticPaths() {
  return locales.flatMap(locale => pageIds.map(page => ({
    params: { path: route(locale, page).replace(/^\/|\/$/g, '') }, props: { locale, page },
  })));
}
interface Props { locale: Locale; page: PageId }
const { locale, page } = Astro.props;
const pages = { home: HomePage, vetting: VettingPage, profiles: ProfilesPage, manifesto: ManifestoPage, contact: ContactPage };
const Page = pages[page];
---
<SiteLayout locale={locale} page={page}><Page locale={locale}/></SiteLayout>
