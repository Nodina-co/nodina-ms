---
import { content, metadata, origin, route, type Locale, type PageId } from '../lib/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { isPreview, pageRobots } from '../lib/publication';
import '../styles/site.css';
import '../styles/talent.css';
import '../styles/refinement.css';
import '../styles/select.css';
import '../styles/forms.css';
import '../styles/analytics.css';
import '../styles/legal.css';
import '../styles/offers.css';
import '../styles/blog.css';
interface Props { locale: Locale; page: PageId; title?: string; description?: string; path?: string; alternates?: Record<Locale, string>; article?: { headline: string; description: string; datePublished: string; url: string; blog: string; author?: { name: string; url: string }; faq?: { question: string; answer: string }[] } }
const { locale, page, path = route(locale, page), alternates = { fr: route('fr', page), en: route('en', page) }, article } = Astro.props;
const c = content[locale];
const { title, description } = { ...metadata(locale, page), ...Astro.props };
const canonical = origin + path;
const ogImage = origin + '/assets/og/' + path.replace(/^\/|\/$/g, '').replace(/\//g, '-') + '.png';
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': origin + '/#organization', name: 'NODINA', url: origin, logo: origin + '/assets/logomark.svg' },
    { '@type': 'WebSite', '@id': origin + '/#website', url: origin, name: 'NODINA', publisher: { '@id': origin + '/#organization' }, inLanguage: ['fr-FR', 'en-US'] },
    { '@type': 'WebPage', '@id': canonical + '#webpage', url: canonical, name: title, description, inLanguage: c.lang, isPartOf: { '@id': origin + '/#website' } },
    ...(['systems', 'teams'].includes(page) ? [{ '@type': 'Service', '@id': canonical + '#service', name: page === 'teams' ? 'AI-native Teams' : (locale === 'fr' ? 'Conseil et intégration IA' : 'AI Consulting & Integration'), description, url: canonical, provider: { '@id': origin + '/#organization' } }] : []),
    ...(page === 'blog' && !article ? [{ '@type': 'Blog', '@id': canonical + '#blog', url: canonical, name: title, description, inLanguage: c.lang, publisher: { '@id': origin + '/#organization' } }] : []),
    ...(article?.author ? [{ '@type': 'Person', '@id': origin + '/#jean-david-collard', name: article.author.name, url: article.author.url, worksFor: { '@id': origin + '/#organization' } }] : []),
    ...(article ? [{ '@type': 'BlogPosting', '@id': canonical + '#article', headline: article.headline, description: article.description, datePublished: article.datePublished, dateModified: article.datePublished, url: canonical, inLanguage: c.lang, mainEntityOfPage: { '@id': canonical + '#webpage' }, isPartOf: { '@id': article.blog + '#blog' }, author: { '@id': origin + (article.author ? '/#jean-david-collard' : '/#organization') }, publisher: { '@id': origin + '/#organization' } }] : []),
    ...(article?.faq ? [{ '@type': 'FAQPage', '@id': canonical + '#faq', mainEntity: article.faq.map(item => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }] : []),
  ],
};
---
<!doctype html>
<html lang={c.lang}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="referrer" content="strict-origin-when-cross-origin"/>
  <meta name="robots" content={pageRobots(locale, page, path)}/>
  <meta name="theme-color" content="#ffffff"/>
  <title>{title}</title><meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  {!isPreview && <><link rel="alternate" type="text/markdown" href={canonical + 'index.md'}/><link rel="alternate" type="application/rss+xml" title="NODINA" href={origin + '/feed.xml'}/></>}
  <link rel="alternate" hreflang="fr-FR" href={origin + alternates.fr}/>
  <link rel="alternate" hreflang="en-US" href={origin + alternates.en}/>
  <link rel="alternate" hreflang="x-default" href={origin + '/'}/>
  <meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:site_name" content="NODINA"/>
  {article && <><meta property="article:published_time" content={article.datePublished}/><meta property="article:modified_time" content={article.datePublished}/></>}
  <meta property="og:locale" content={c.lang.replace('-', '_')}/><meta property="og:url" content={canonical}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
  <meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={title}/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={ogImage}/>
  <link rel="icon" href="/assets/logomark.svg" type="image/svg+xml"/>
  <link rel="preload" href="/assets/intertight.woff2" as="font" type="font/woff2" crossorigin/>
  <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}/>
  <script id="analytics-config" type="application/json" set:html={JSON.stringify({
    enabled: import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true',
    preview: import.meta.env.PUBLIC_ANALYTICS_PREVIEW === 'true', title,
  }).replace(/</g, '\\u003c')}/>
</head>
<body id="top">
  <a class="skip" href="#content">{c.skip}</a>
  <SiteHeader locale={locale} page={page}/><slot/><SiteFooter locale={locale}/>
  <AnalyticsConsent locale={locale}/>
  <script>import '../scripts/site.js'; import '../scripts/contact.js'; import '../../tools/forms/candidate/client.js'; import { initAnalytics } from '../scripts/analytics.js'; initAnalytics();</script>
</body>
</html>
