---
import { route, type Locale, type PageId } from '../lib/site';
import { legalCopy } from '../lib/legal';
import { legalNoticeCopy } from '../lib/legal-notice';
import { isPreview } from '../lib/publication';
interface Props { locale: Locale; page: PageId }
const { locale, page } = Astro.props;
const kind = page === 'legal' ? 'legal' : page === 'cookies' ? 'cookies' : 'privacy';
const c = legalCopy[locale];
const notice = legalNoticeCopy[locale];
const policy = kind === 'legal' ? notice.policy : c[kind];
const date = kind === 'legal' ? notice.date : c.date;
const draftTitle = kind === 'legal' ? notice.draftTitle : c.draftTitle;
const draftBody = kind === 'legal' ? notice.draftBody : c.draftBody;
---
<main id="content" class="legal-page wrap" data-policy={kind}>
  <a class="text-link back" href={route(locale)}>{c.back}</a>
  <header class="legal-heading"><p class="label">{kind === 'legal' ? (locale === 'fr' ? 'Informations légales' : 'Legal information') : c.label}</p><h1>{policy.title}</h1><p class="legal-lead">{policy.lead}</p><p class="legal-date">{date}</p></header>
  {isPreview && <aside class="legal-draft" aria-labelledby="legal-draft-title" data-legal-draft>
    <h2 id="legal-draft-title">{draftTitle}</h2><p>{draftBody}</p>
  </aside>}
  <div class="legal-grid">
    <nav class="legal-contents" aria-label={c.contents}><p class="label">{c.contents}</p><ol>{policy.sections.map(section => <li><a href={'#' + section.id}>{section.title}</a></li>)}</ol></nav>
    <article class="legal-body" aria-label={policy.title}>
      {policy.sections.map(section => <section id={section.id} aria-labelledby={section.id + '-title'}>
        <h2 id={section.id + '-title'}>{section.title}</h2>
        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
        {section.links && <ul class="legal-links">{section.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
      </section>)}
      <p class="legal-related"><a href={route(locale, kind === 'privacy' ? 'cookies' : 'privacy')}>{kind === 'privacy' ? c.cookies.title : c.privacy.title}</a>{kind === 'legal' && <> · <a href={route(locale, 'cookies')}>{c.cookies.title}</a></>}</p>
    </article>
  </div>
</main>
