---
import { content, route, type Locale } from '../lib/site';
import Action from './Action.astro';
import SectionHeading from './SectionHeading.astro';
import ProfileCards from './ProfileCards.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const s = content[locale].select;
---
<section class="profiles-teaser section wrap" aria-labelledby="profiles-title">
  <SectionHeading label={'AI-native Teams · ' + s.profiles_nav} title={s.profiles_title} id="profiles-title" service="teams"/>
  <p class="section-intro">{s.profiles_lead}</p><ProfileCards locale={locale}/>
  <div class="actions"><Action href={route(locale, 'profiles')} label={s.profiles_cta}/></div>
</section>
