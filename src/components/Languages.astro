---
import { locales, route, type Locale, type PageId } from '../lib/site';
interface Props { locale: Locale; page: PageId }
const { locale, page } = Astro.props;
---
<div class="languages" aria-label={locale === 'fr' ? 'Langue' : 'Language'}>
  {locales.map(lang => lang === locale
    ? <span aria-current="true" lang={lang}>{lang.toUpperCase()}</span>
    : <a href={route(lang, page)} hreflang={lang} lang={lang} aria-label={lang === 'fr' ? 'Français' : 'English'}>{lang.toUpperCase()}</a>)}
</div>
