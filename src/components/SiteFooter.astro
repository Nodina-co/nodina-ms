---
import { content, route, type Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale: l } = Astro.props;
const c = content[l];
const sections = ['offers', 'approach', 'experience', 'faq'];
const labels = [...c.nav, 'FAQ'];
---
<footer class="site-footer"><div class="wrap"><div class="footer-main">
  <div><a class="brand" href={route(l)} aria-label={c.home}><img src="/assets/logo-white.svg" width="134" height="29" alt="NODINA"/></a><p>{c.footer_desc}</p></div>
  <nav class="footer-nav" aria-label={l === 'fr' ? 'Navigation de pied de page' : 'Footer navigation'}>
    {sections.map((section, i) => <a href={route(l) + '#' + section}>{labels[i]}</a>)}
    <a href={route(l, 'vetting')}>{c.select.selection_nav}</a><a href={route(l, 'profiles')}>{c.select.profiles_nav}</a><a href={route(l, 'manifesto')}>{c.select.manifesto_nav}</a><a href={route(l, 'contact')}>Contact</a>
    <a href={route(l, 'privacy')}>{l === 'fr' ? 'Confidentialité' : 'Privacy'}</a><a href={route(l, 'cookies')}>Cookies</a>
    <a href={route(l, 'legal')}>{l === 'fr' ? 'Mentions légales' : 'Legal notice'}</a>
  </nav>
</div><div class="footer-bottom"><span>{c.footer_note}</span><button type="button" class="analytics-preferences" data-analytics-preferences hidden>{l === 'fr' ? 'Préférences de mesure' : 'Measurement preferences'}</button><a href="#top">{c.top}</a></div></div></footer>
