---
import { content, contactPath, type Locale } from '../lib/site';
import Action from './Action.astro';
interface Props { locale: Locale }
const { locale: l } = Astro.props;
const s = content[l].select;
---
<div class="profile-grid" id="profile-grid">
  {s.profiles.map((p, index) => <article class="profile-card" id={p.id} aria-labelledby={p.id + '-title'}>
    <p class="label profile-number">{s.profile_badge} {String(index + 1).padStart(2, '0')}</p>
    <h3 id={p.id + '-title'}>{p.role}</h3>
    <p class="profile-summary">{p.summary}</p>
    <div class="profile-ai"><h4>{s.profile_ai_label}</h4><p>{p.ai}</p></div>
    <ul class="stack-tags" aria-label={l === 'fr' ? 'Compétences' : 'Skills'}>{p.skills.map(skill => <li>{skill}</li>)}</ul>
    <Action href={contactPath(l)} label={s.profile_cta}/>
  </article>)}
</div>
